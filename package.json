{
	"name": "guki-chat",
	"version": "1.1.2",
	"description": "Chat with Claude Code inside your vault",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"check:offline": "npx esbuild docs/offline-checks.ts --bundle --platform=node --format=esm --alias:obsidian=./docs/obsidian-stub.js --loader:.mjs=text --outfile=/tmp/guki-checks.mjs && node /tmp/guki-checks.mjs",
		"check:capture": "python3 docs/scrub-capture.py --check docs/capture-*.jsonl",
		"check:docs": "python3 docs/scrub-capture.py --check docs/*.md",
		"check": "npm run check:capture && npm run check:docs && npm run check:offline",
		"test": "npm run check"
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	}
}
