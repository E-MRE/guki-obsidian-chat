node_modules/
main.js
# The build copy of the MCP permission server. Root-anchored on purpose: the source lives at
# src/cli/mcp-permission-server.mjs and must stay tracked, and an unanchored pattern matches at
# every level — it silently untracked the source the first time it was written without the slash.
/mcp-permission-server.mjs
*.js.map
data.json
.DS_Store

# Internal dev diary — planning/measurement notes and per-task acceptance write-ups.
# Kept locally for the workflow this project uses (fresh-agent briefs read these), but they
# reference real local paths and aren't meant to ship in the public repo. The test harness
# (offline-checks.ts and its fixtures) is NOT in this list — it stays public and tracked.
/docs/PLAN.md
/docs/RESEARCH.md
/docs/NEXT.md
/docs/archive/

# Orchestration workspace — lane briefs, agent evidence logs and campaign records.
# Same category as the dev diary above: written for fresh-agent briefs, full of real local
# paths, and 15MB of logs. Kept on disk (agents read it), never shipped in the public repo.
/.orchestration/
/.claude/
# Local agent skills and worker configuration are operational material, not plugin source.
/.agents/
